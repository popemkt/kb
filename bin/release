#!/bin/sh
# Cuts a stable kb release: `bun run release [--dry-run] <bump>`, where <bump>
# is patch, minor, major or an explicit major.minor.patch. The Actions
# "Release" workflow runs this same script; run by hand, it is the local way.
#
# Sets package.json's version — the one source `kb --version` and the
# extension SDK header read — regenerates the SDK module that embeds it, adds
# the release's section to CHANGELOG.md, commits, and makes the annotated tag
# v<version>. It pushes nothing. --dry-run prints the version and the notes
# and stops before any of that. The version is bin/release-version's; the
# notes are bin/release-notes', the same generator the GitHub release uses.
set -eu

dry_run=false
if [ "${1:-}" = "--dry-run" ]; then
  dry_run=true
  shift
fi
if [ $# -ne 1 ] || [ "$1" = "nightly" ]; then
  echo "usage: bun run release [--dry-run] patch|minor|major|<major.minor.patch>" >&2
  exit 2
fi

kb=$(cd "$(dirname "$0")/.." && pwd)
cd "$kb"

version=$(bin/release-version "$1")
if git rev-parse -q --verify "refs/tags/v$version" >/dev/null; then
  echo "release: tag v$version already exists" >&2
  exit 1
fi

section=$(mktemp)
trap 'rm -f "$section"' EXIT
{
  echo "## v$version — $(date -u +%Y-%m-%d)"
  echo
  bin/release-notes HEAD
} >"$section"

if [ "$dry_run" = true ]; then
  echo "release: dry run, v$version from $(git rev-parse --short HEAD); nothing committed or tagged"
  echo
  cat "$section"
  exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "release: the working tree is not clean" >&2
  exit 1
fi

# shellcheck disable=SC2016 # the script is JavaScript; its $1 and ${} are not the shell's
bun -e '
const path = "package.json";
const text = await Bun.file(path).text();
const next = text.replace(/^(  "version": )"[^"]*"/m, `$1${JSON.stringify(process.argv[1])}`);
if (next === text && JSON.parse(text).version !== process.argv[1]) throw new Error("no top-level version line in package.json");
await Bun.write(path, next);
' "$version"
bun run gen:ext-sdk

# The newest section goes above the previous release's, under the preamble.
awk -v section="$section" '
  !done && /^## / { while ((getline line < section) > 0) print line; print ""; done = 1 }
  { print }
  END { if (!done) { print ""; while ((getline line < section) > 0) print line } }
' CHANGELOG.md >CHANGELOG.md.next
mv CHANGELOG.md.next CHANGELOG.md

git add package.json packages/contract/ext-sdk/src/sdk-dts.text.ts CHANGELOG.md
git commit -m "chore: release v$version"
git tag -a "v$version" -m "kb v$version"
echo "tagged v$version; publish with: git push origin HEAD:main v$version"
