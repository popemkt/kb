#!/bin/sh
# Refresh the marketplace kb ships (DESIGN.md → kb ships its own
# marketplace): read popemkt/kb-extensions' index at a commit and write the
# pin and the exact bytes kb's build carries.
#
#   bin/refresh-kb-marketplace [ref]      (default: main)
#
# It reads the index the way an added marketplace is read: `kb ext
# marketplace add` in a scratch home and data directory, so the pin and its
# file-set hash are what any kb would compute. Nothing on this machine is
# touched. Review the diff and commit it; that commit moves the pin.
set -eu

cd "$(dirname "$0")/.."

ref=${1:-main}
original=github:popemkt/kb-extensions
out=packages/app/bundled/src/marketplace
scratch="$(mktemp -d)"
# The source cache keeps its trees read-only.
trap 'chmod -R u+w "$scratch"; rm -rf "$scratch"' EXIT
export KB_HOME="$scratch/home" KB_DATA="$scratch/data"
mkdir -p "$KB_HOME" "$KB_DATA" "$scratch/root"
git -C "$scratch/root" init -q
root="$(pwd)"

(cd "$scratch/root" && "$root/bin/kb" init > /dev/null)
added="$(cd "$scratch/root" && "$root/bin/kb" --json ext marketplace add "$original@$ref" --scope user)"
name="$(printf '%s' "$added" | jq -er '.output.name')"
locked="$(printf '%s' "$added" | jq -ec '.output.selection.locked')"
rev="$(printf '%s' "$locked" | jq -er '.rev')"
# The tree the add stored, by the pin's file-set hash.
files="$(printf '%s' "$locked" | jq -er '.files | ltrimstr("sha256:") | .[0:32]')"
index="$(find "$KB_DATA/extensions/store" -path "*/$files-*/kb-marketplace.json" | head -n 1)"
[ -n "$index" ] || { echo "error: the fetched index is not in the scratch cache" >&2; exit 1; }

cat > "$out/kb.pin.ts" <<EOF
// Generated by bin/refresh-kb-marketplace from $original at $rev. Do not edit.
import type { ExtensionSelection } from "@kb/contracts";

export const KB_MARKETPLACE_NAME = $(printf '%s' "$name" | jq -R .);
export const KB_MARKETPLACE_SELECTION: ExtensionSelection = {
  original: $(printf '%s' "$original" | jq -R .),
  locked: $locked,
};
EOF
cat > "$out/kb.index.ts" <<EOF
// Generated by bin/refresh-kb-marketplace from $original at $rev. Do not edit.
// The pinned kb-marketplace.json exactly: its bytes hash to the pin's files.
export const KB_MARKETPLACE_INDEX = $(jq -Rs . < "$index");
EOF
bun run fmt > /dev/null
echo "kb marketplace: $name pinned to $rev"
