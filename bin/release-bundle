#!/bin/sh
# Builds kb's platform-independent release bundle from this checkout:
#   out/kb-<version>/bin/kb                         sh launcher
#   out/kb-<version>/lib/kb/cli.js                  the CLI, one bun-target script
#   out/kb-<version>/lib/kb/packages/app/ui/dist    the UI it serves
# packed as out/kb-<version>.tar.gz with out/kb-<version>.tar.gz.sha256.
# The version is package.json's, or the one given as `bin/release-bundle
# <version>` — a nightly's, which is derived, never committed
# (bin/release-version). A given version is stamped into the SDK module the
# CLI reads `--version` from for this build only; the committed module is put
# back afterwards. The lib/kb layout is the one KB_PKG_ROOT names
# (packages/app/server/src/paths.ts). Needs bun and installed deps.
set -eu

kb=$(cd "$(dirname "$0")/.." && pwd)
cd "$kb"

version=${1:-$(bun -p 'require("./package.json").version')}
name="kb-$version"
out="$kb/out"
stage="$out/$name"
rm -rf "$stage" "$out/cli" "$out/$name.tar.gz" "$out/$name.tar.gz.sha256"
mkdir -p "$out"

sdk="$kb/packages/contract/ext-sdk/src/sdk-dts.text.ts"
cp "$sdk" "$out/sdk-dts.text.ts.committed"
trap 'mv "$out/sdk-dts.text.ts.committed" "$sdk"' EXIT
bun packages/contract/ext-sdk/scripts/generate.ts --version "$version"

(cd packages/app/ui && bun run build)
bun build packages/app/cli/src/main.ts --outdir "$out/cli" --target=bun --sourcemap=none

mkdir -p "$stage/bin" "$stage/lib/kb/packages/app/ui"
cp "$out/cli/main.js" "$stage/lib/kb/cli.js"
cp -R packages/app/ui/dist "$stage/lib/kb/packages/app/ui/dist"
for f in README.md LICENSE; do
  if [ -f "$f" ]; then cp "$f" "$stage/"; fi
done

cat >"$stage/bin/kb" <<'LAUNCHER'
#!/bin/sh
# kb launcher: runs the bundled CLI on the bun on PATH, and tells it where the
# UI it serves sits. Follows symlinks, so it can be linked onto PATH.
set -eu
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
if ! command -v bun >/dev/null 2>&1; then
  echo "kb: bun is not on PATH; kb runs on bun (https://bun.sh)" >&2
  exit 127
fi
KB_PKG_ROOT="$root/lib/kb"
export KB_PKG_ROOT
exec bun "$root/lib/kb/cli.js" "$@"
LAUNCHER
chmod +x "$stage/bin/kb"

tar -C "$out" -czf "$out/$name.tar.gz" "$name"
cd "$out"
if command -v sha256sum >/dev/null 2>&1; then
  sha256sum "$name.tar.gz" >"$name.tar.gz.sha256"
else
  shasum -a 256 "$name.tar.gz" >"$name.tar.gz.sha256"
fi
rm -rf "$out/cli"
echo "$out/$name.tar.gz"
